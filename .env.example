# 复制这个文件为 .env，然后填上你自己的值
# .env 已被 .gitignore 忽略，不会被提交

# JWT 签名密钥。随便生成一串长随机字符串即可，例如：
#   python -c "import secrets; print(secrets.token_hex(32))"
APP_SECRET=

# 数据库连接串
DATABASE_URL=mysql+pymysql://dev:your_password@localhost/llm_gateway_db?charset=utf8mb4

# LLM 调用模式：mock（默认，不调真实 API）/ real
LLM_MODE=mock
